MODULE INTERACTION (main flows)

 1. Add money     : CLI -> WalletService -> BankAccount.debit + Wallet.credit -> TransactionRepository
 2. Transfer      : CLI -> TransferService
                       -> PinSecurityService (verify PIN)
                       -> TransactionService.isDuplicate (1 min rule)
                       -> TransferTransaction.execute (debit sender + credit receiver, rollback on failure)
                       -> RewardService.giveCashback (if Success and amount >= 500)
 3. Dispute       : CLI -> DisputeService (Success transfer, within 24h) -> DisputeRepository
 4. Reversal      : Admin CLI -> ReversalService
                       -> RefundTransaction.execute (debit receiver, credit sender)
                       -> Pending if receiver balance is low
                       -> RewardService reverses the cashback too
 5. History       : CLI -> TransactionService (latest first; filter by type, status, date range)
